# BidReady configuration. Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# .env is gitignored and never uploaded to Vercel. Never commit real keys.

# --- used now -------------------------------------------------------------
# TinyFish API key for "Live web · TinyFish" search. Empty = live search shows a calm "unavailable" panel;
# locally the installed tinyfish CLI's own login is tried as a fallback.
TINYFISH_API_KEY=

# synthetic = demo tenders, profiles and history from backend/data.py (shown in /api/health).
BIDREADY_MODE=synthetic

# TinyFish Search endpoint (default https://api.search.tinyfish.ai/).
TINYFISH_SEARCH_URL=

# --- reserved for live mode (not read yet; the MVP simulates these stages) -
# Fetch: retrieve tender documents from a known URL.
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
# Agent: schema-bound clause extraction (criterion, heading, quote, URL).
TINYFISH_AGENT_URL=https://agent.tinyfish.ai/v1/automation/run

# Anthropic (Claude): AI clause extraction from tender PDFs and profile pre-fill from uploaded certificates.
# Extraction only; the eligibility decision always stays in backend/rules.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
