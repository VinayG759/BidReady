# BidReady configuration. Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# .env is gitignored and never uploaded to Vercel. Never commit real keys.

# Anthropic (Claude): reads tender PDFs and returns eligibility clauses with verbatim quotes.
# Every quote is validated against the document; the eligibility decision always stays in backend/rules.py.
# Empty = the GeM template parser still works; the stored bid library uses cached Claude results.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# TinyFish: web discovery (Search) and reading non-PDF tender pages (Fetch).
# Empty = the "Web · TinyFish" tab shows a calm "unavailable" panel; live GeM search still works.
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# live = real GeM bids (stored library + live GeM search). Shown in /api/health.
BIDREADY_MODE=live
